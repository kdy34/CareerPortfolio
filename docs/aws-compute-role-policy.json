{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendContactEmail",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:us-east-1:ACCOUNT_ID:identity/*"
    },
    {
      "Sid": "ContactRateLimit",
      "Effect": "Allow",
      "Action": "dynamodb:UpdateItem",
      "Resource": "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/portfolio-contact-rate-limit"
    }
  ]
}
