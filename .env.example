# ---- Site ----
# Public URL once your domain is set (used for canonical URLs, sitemap, OG).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Keep "false" until launch. Robots and meta tags block indexing while false.
NEXT_PUBLIC_SITE_INDEXABLE=false

# ---- Contact form ----
# Provider: only "resend" is implemented.
CONTACT_PROVIDER=resend
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend, e.g. "Portfolio <hello@your-domain.com>"
CONTACT_FROM_EMAIL=
# Fixed recipient (your inbox). Never taken from the request.
CONTACT_TO_EMAIL=

# ---- Rate limit (required in production) ----
# Upstash Redis REST credentials (Vercel Marketplace → Upstash). KV_REST_API_URL /
# KV_REST_API_TOKEN are also accepted if the integration injects those names. Without them,
# production returns 503 instead of running an unreliable per-instance limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600

# ---- Local development only ----
# "true" makes /api/contact accept messages without sending email (ignored in production).
CONTACT_DEV_MOCK=true
