# ---- Site ----
# Public URL once your domain is set (canonical URLs, sitemap, social cards).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Keep "false" until launch. While false, robots.txt, meta robots and an
# X-Robots-Tag header keep the site out of search results.
NEXT_PUBLIC_SITE_INDEXABLE=false

# ---- Contact form email (Amazon SES by default) ----
CONTACT_PROVIDER=ses
# Region where your SES identities and DynamoDB table live.
# (Amplify reserves names starting with AWS_, so this one is prefixed.)
CONTACT_AWS_REGION=us-east-1
# A verified SES identity: an address on your verified domain, e.g. "Portfolio <hello@your-domain.com>"
CONTACT_FROM_EMAIL=
# Fixed recipient (your inbox). Never taken from the request.
CONTACT_TO_EMAIL=
# Only if CONTACT_PROVIDER=resend:
# RESEND_API_KEY=

# ---- Rate limit (required in production) ----
# DynamoDB table with partition key "pk" (String) and TTL attribute "expiresAt".
RATE_LIMIT_TABLE=portfolio-contact-rate-limit
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
# Alternative to DynamoDB: Upstash Redis REST credentials.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Local development only ----
# "true" makes /api/contact accept messages without sending email (ignored in production).
CONTACT_DEV_MOCK=true
# Locally, leave RATE_LIMIT_TABLE empty to use the in-memory limit.
